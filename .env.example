# ══════════════════════════════════════════════════════════════════════════════
# OpenIntentOS — Environment Configuration
#
# Quick start: you only need ONE AI provider key to get started.
# The onboarding wizard (openintent serve on first run) will guide you.
# ══════════════════════════════════════════════════════════════════════════════

# ── Required: at least one AI provider ───────────────────────────────────────
# See "Free AI Providers" section below if you don't have a key yet.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── Optional overrides ────────────────────────────────────────────────────────
# OPENINTENT_BIND=127.0.0.1
# OPENINTENT_PORT=3000
# OPENINTENT_MODEL=claude-sonnet-4-20250514
# RUST_LOG=info

# Set this to "cn" to get Chinese provider recommendations in onboarding
# OPENINTENT_REGION=cn

# ══════════════════════════════════════════════════════════════════════════════
# FREE AI PROVIDERS (no credit card required)
# ══════════════════════════════════════════════════════════════════════════════

# ── 🇨🇳 China (no VPN needed) ─────────────────────────────────────────────────

# SiliconFlow 硅基流动 — 14M free tokens/month, hosts DeepSeek/Qwen/GLM
# Register: https://siliconflow.cn
# SILICONFLOW_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# DeepSeek — ¥10 free credit for new users
# Register: https://platform.deepseek.com
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Moonshot (Kimi) — free trial credit
# Register: https://platform.moonshot.cn
# MOONSHOT_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Zhipu AI (GLM-4-Flash is permanently free)
# Register: https://open.bigmodel.cn
# ZHIPU_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Tongyi Qwen (Alibaba) — free tier available
# Register: https://dashscope.aliyun.com
# DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── 🌍 International ──────────────────────────────────────────────────────────

# NVIDIA NIM — free 1000 credits/month, 400B+ parameter models
# Register: https://build.nvidia.com (no credit card)
# NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Gemini — free tier with generous limits
# Register: https://aistudio.google.com/apikey (no credit card)
# GOOGLE_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Groq — free tier, fastest inference available
# Register: https://console.groq.com (no credit card)
# GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ══════════════════════════════════════════════════════════════════════════════
# PAID AI PROVIDERS
# ══════════════════════════════════════════════════════════════════════════════

# OpenAI
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# xAI (Grok)
# XAI_API_KEY=xai-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Mistral
# MISTRAL_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenRouter (access 700+ models via one key)
# OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ChatGPT Pro (session token — no API cost if you have a Pro subscription)
# CHATGPT_SESSION_TOKEN=eyJhbGciOiJkaXIiLCJlbmMiOiJBMjU2R0NNIn0...

# ══════════════════════════════════════════════════════════════════════════════
# CHAT CHANNELS
# ══════════════════════════════════════════════════════════════════════════════

# ── Telegram ──────────────────────────────────────────────────────────────────
# Get from: https://t.me/BotFather → /newbot
# TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── WeChat Official Account (公众号) ─────────────────────────────────────────
# Get from: https://mp.weixin.qq.com → 开发 → 基本配置
# WECHAT_OA_APP_ID=wx1234567890abcdef
# WECHAT_OA_APP_SECRET=your_app_secret

# ── DingTalk (钉钉) ───────────────────────────────────────────────────────────
# Option A: Custom Robot Webhook (easiest, outbound-only)
# DINGTALK_WEBHOOK_URL=https://oapi.dingtalk.com/robot/send?access_token=xxx
# DINGTALK_WEBHOOK_SECRET=SECxxx   # signing secret (if enabled)
#
# Option B: Enterprise Internal App
# DINGTALK_APP_KEY=dingxxxxxxxxxxxxxxxxxx
# DINGTALK_APP_SECRET=your_app_secret

# ── WeCom / 企业微信 ──────────────────────────────────────────────────────────
# Option A: Group Robot Webhook (outbound-only)
# WECOM_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx
#
# Option B: Internal App (full integration)
# WECOM_CORP_ID=ww1234567890abcdef
# WECOM_CORP_SECRET=your_corp_secret
# WECOM_AGENT_ID=1000002

# ── QQ Official Bot ───────────────────────────────────────────────────────────
# QQ_BOT_APP_ID=12345678
# QQ_BOT_APP_SECRET=your_app_secret

# ── Discord ───────────────────────────────────────────────────────────────────
# DISCORD_BOT_TOKEN=your_discord_bot_token

# ── Slack ─────────────────────────────────────────────────────────────────────
# SLACK_BOT_TOKEN=xoxb-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# SLACK_SIGNING_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ══════════════════════════════════════════════════════════════════════════════
# CONTENT & SOCIAL PLATFORMS
# ══════════════════════════════════════════════════════════════════════════════

# ── Bilibili Open Live ────────────────────────────────────────────────────────
# BILI_ACCESS_KEY_ID=your_access_key_id
# BILI_ACCESS_KEY_SECRET=your_access_key_secret
# BILI_APP_ID=your_app_id

# ── Douyin (抖音) Open Platform ───────────────────────────────────────────────
# DOUYIN_CLIENT_KEY=your_client_key
# DOUYIN_CLIENT_SECRET=your_client_secret
# DOUYIN_ACCESS_TOKEN=user_oauth_access_token
# DOUYIN_OPEN_ID=user_open_id

# ── XiaoHongShu (小红书) Ark Platform ────────────────────────────────────────
# XHS_APP_KEY=your_app_key
# XHS_APP_SECRET=your_app_secret

# ── Weibo ─────────────────────────────────────────────────────────────────────
# WEIBO_APP_KEY=your_app_key
# WEIBO_APP_SECRET=your_app_secret
# WEIBO_ACCESS_TOKEN=user_oauth_access_token

# ══════════════════════════════════════════════════════════════════════════════
# PROXY (for GFW / Clash / Surge users)
# ══════════════════════════════════════════════════════════════════════════════
# Supports http://, https://, socks5:// schemes.
# All adapters (Telegram, web_fetch, GitHub, Slack, etc.) route through this.
# HTTPS_PROXY=http://127.0.0.1:7890
# ALL_PROXY=socks5://127.0.0.1:7891
